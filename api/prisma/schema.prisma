// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Vehicle {
  id                 String     @id @default(uuid())
  manufacturer       String
  model              String     @unique
  sector             String     @default("General Freight")
  imageUrl           String     @default("")
  type               String
  fuelType           String
  payloadCapacity    Float      // in kg
  gvwr               Float?     // in kg
  fuelConsumption    Float      // L/100km
  fuelTankCapacity   Float      // in L
  cargoVolume        Float      // in m³
  maxSpeed           Float      // in km/h
  avgSpeed           Float      // in km/h
  co2EmissionFactor  Float      // kg CO2 per L fuel
  isSystemData       Boolean    @default(true)
  shipments          Shipment[]
  createdAt          DateTime   @default(now())
}

model Shipment {
  id                String             @id @default(uuid())
  origin            String
  destination       String
  originLat         Float
  originLng         Float
  destLat           Float
  destLng           Float
  transportMode     String             @default("ROAD")
  status            String             @default("PENDING") // PENDING, OPTIMIZING, OPTIMIZED, COMPLETED
  cargo             Cargo?
  vehicleId         String?
  vehicle           Vehicle?           @relation(fields: [vehicleId], references: [id])
  intermediateStops IntermediateStop[]
  optimizationJobs  OptimizationJob[]
  createdAt         DateTime           @default(now())
}

model Cargo {
  id                    String   @id @default(uuid())
  description           String
  weight                Float    // in kg
  volume                Float    // in m³
  packages              Int
  deadline              DateTime
  fragile               Boolean  @default(false)
  temperatureControlled Boolean  @default(false)
  hazardous             Boolean  @default(false)
  shipmentId            String   @unique
  shipment              Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model IntermediateStop {
  id                  String   @id @default(uuid())
  name                String
  lat                 Float
  lng                 Float
  arrival             DateTime?
  departure           DateTime?
  duration            Float    @default(0) // in minutes
  distanceFromPrev    Float    @default(0) // in km
  stopOrder           Int
  shipmentId          String
  shipment            Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model OptimizationJob {
  id              String            @id @default(uuid())
  shipmentId      String
  shipment        Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status          String            @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  costWeight      Float             @default(0.0)
  timeWeight      Float             @default(0.0)
  fuelWeight      Float             @default(0.0)
  co2Weight       Float             @default(0.0)
  tollWeight      Float             @default(0.0)
  solver          String            @default("QAOA_SIMULATOR")
  variables       Int               @default(0)
  constraintsCount Int              @default(0)
  finalObjective  Float?
  routes          Route[]
  agentRuns       AgentRun[]
  payments        Payment[]
  constraints     Constraint[]
  milestones      EscrowMilestone[]
  tollPayments    TollPayment[]
  createdAt       DateTime          @default(now())
}

model Route {
  id              String             @id @default(uuid())
  jobId           String
  job             OptimizationJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name            String
  distance        Float              // in km
  duration        Float              // in minutes
  geometry        String             // JSON GeoJSON or polyline string
  fuelConsumption Float              // in L
  fuelCost        Float              // in currency
  tollCost        Float              // in currency
  tollGates       Json?              // JSON array of toll gates
  co2Emissions    Float              // in kg CO2
  totalCost       Float              // in currency
  score           Float              // objective value
  isSelected      Boolean            @default(false)
  alternatives    RouteAlternative[]
  createdAt       DateTime           @default(now())
}

model RouteAlternative {
  id          String   @id @default(uuid())
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name        String
  distance    Float
  duration    Float
  totalCost   Float
  fuel        Float
  co2         Float
  tolls       Float
  type        String   // CHEAPEST, FASTEST, BALANCED
}

model AgentRun {
  id         String          @id @default(uuid())
  jobId      String
  job        OptimizationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentName  String          // LOGISTICS, ROUTE, VEHICLE, QUANTUM_OPTIMIZATION, VERIFICATION, PAYMENT
  status     String          // PENDING, RUNNING, SUCCESS, FAILED
  logs       String          @default("")
  timestamp  DateTime        @default(now())
}

model Payment {
  id            String               @id @default(uuid())
  jobId         String
  job           OptimizationJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount        Float                @default(0.05)
  asset         String               @default("USDC")
  network       String               @default("ALGORAND_TESTNET")
  status        String               @default("UNPAID") // UNPAID, PENDING, PAID, FAILED
  transactionId String?              // Algorand transaction hash
  transactions  PaymentTransaction[]
  splits        PaymentSplit[]
  createdAt     DateTime             @default(now())
}

model PaymentSplit {
  id                 String   @id @default(uuid())
  paymentId          String
  payment            Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  partyName          String   // e.g. "Carrier Fleet Operator", "Carbon Offset Fund"
  partyRole          String   // CARRIER, CARBON_FUND, TOLL_ESCROW, PROTOCOL_FEE
  percentage         Float    // e.g. 85.0
  amount             Float    // in USDC
  destinationAddress String
  txHash             String?
  status             String   @default("SETTLED") // PENDING, SETTLED
  createdAt          DateTime @default(now())
}

model PaymentTransaction {
  id        String   @id @default(uuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  txHash    String   @unique
  sender    String
  receiver  String
  amount    Float
  timestamp DateTime @default(now())
}

model EscrowMilestone {
  id              String          @id @default(uuid())
  jobId           String
  job             OptimizationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title           String          // e.g. "Origin Check-in & Departure"
  description     String
  orderIndex      Int
  percentage      Float           // e.g. 30.0
  amount          Float           // in USDC
  status          String          @default("LOCKED") // LOCKED, RELEASED, REFUNDED
  releaseTxHash   String?
  releaseTime     DateTime?
  createdAt       DateTime        @default(now())
}

model TollPayment {
  id        String          @id @default(uuid())
  jobId     String
  job       OptimizationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tollName  String
  lat       Float
  lng       Float
  amount    Float           // in USDC
  asset     String          @default("USDC")
  txHash    String
  status    String          @default("SETTLED")
  createdAt DateTime        @default(now())
}

model Constraint {
  id          String          @id @default(uuid())
  jobId       String
  job         OptimizationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type        String          // PAYLOAD_LIMIT, VOLUME_LIMIT, BUDGET_LIMIT, DEADLINE_LIMIT
  limitValue  Float
  actualValue Float
  status      String          // PASS, FAIL
}

