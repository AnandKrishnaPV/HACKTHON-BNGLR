# Database
DATABASE_URL="postgresql://user:password@localhost:5432/qswarm?schema=public"
PORT=8080

# Routing and Geocoding APIs
# OpenRouteService or Mapbox API Keys required for real routing
ROUTING_API_KEY=""
GEOCODING_API_KEY=""

# Vehicle API (Optional, if using external source)
VEHICLE_API_KEY=""

# Python Optimization Service
OPTIMIZATION_SERVICE_URL="http://localhost:8000"

# Algorand TestNet configuration
ALGORAND_NODE_URL="https://testnet-api.algonode.cloud"
ALGORAND_INDEXER_URL="https://testnet-idx.algonode.cloud"
ALGORAND_NETWORK="testnet"

# x402 Facilitator URL
X402_FACILITATOR_URL="https://facilitator.goplausible.com"
X402_PRICE="0.05"
X402_PAYMENT_ASSET="USDC"

# Agent Wallet configuration (funded with ALGO + TestNet USDC)
# The private key should be a 25-word mnemonic or 64-character hex string
WALLET_ADDRESS=""
AGENT_WALLET_ADDRESS=""
AGENT_WALLET_MNEMONIC=""

# Server Private Key (if using specific signing for API)
SERVER_PRIVATE_KEY=""
